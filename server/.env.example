# Copy to .env and fill in real values. Never commit .env.

# MongoDB: set MONGODB_URI (recommended, e.g. MongoDB Atlas SRV string)...
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alumni?retryWrites=true&w=majority
# ...or leave MONGODB_URI empty to use the legacy cluster with these credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT secrets (long random strings)
ACCESS_SECRET_KEY=replace_with_random_access_secret
REFRESH_SECRET_KEY=replace_with_random_refresh_secret

# Server
PORT=8000
# Public URL of this API (used to build uploaded image URLs)
SERVER_URL=http://localhost:8000
# Comma-separated allowed frontend origins (unset = allow all)
CORS_ORIGIN=http://localhost:3000

# Optional: password for users created by `npm run seed` (default: Alumni@123)
SEED_PASSWORD=
